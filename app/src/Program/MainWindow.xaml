<Window x:Class="NativeDnsOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDNO - PC DNS Network Optimizer" 
        Icon="pack://application:,,,/assets/icon.png"
        Height="800" Width="1160"
        MinHeight="620" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0d1117"
        Foreground="#f0f6fc"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#10b981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#9ca3af"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryBtn">
            <Setter Property="Background" Value="#21262d"/>
            <Setter Property="Foreground" Value="#c9d1d9"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363d"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActionCellBtn">
            <Setter Property="Background" Value="#1f2937"/>
            <Setter Property="Foreground" Value="#38bdf8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0284c7"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                                <Setter Property="BorderBrush" Value="#0284c7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox ToggleButton -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent">
                        <Path x:Name="Arrow"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="#8b949e"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="Background" Value="#21262d"/>
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#484f58"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#f0f6fc"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="Background" Value="#21262d"/>
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#10b981"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#10b981"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="TemplateRoot" Property="Background" Value="#0d1117"/>
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#21262d"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#484f58"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Item Style -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#161b22"/>
            <Setter Property="Foreground" Value="#f0f6fc"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                Margin="2,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#21262d"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#30363d"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1f2937"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#10b981"/>
                                <Setter Property="Foreground" Value="#10b981"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#263342"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#34d399"/>
                                <Setter Property="Foreground" Value="#34d399"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBox Style -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#161b22"/>
            <Setter Property="Foreground" Value="#f0f6fc"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,2,28,2"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource DarkComboBoxToggleButton}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#f0f6fc"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownOverlay"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                        MaxHeight="320"
                                        Background="#161b22"
                                        BorderBrush="#30363d"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,3,0,0"
                                        Padding="3">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="True" MaxHeight="300">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownOverlay" Property="MinHeight" Value="60"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#484f58"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="#10b981"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6e7681"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/assets/icon.png" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="PDNO — DNS Optimizer" FontSize="22" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                    <Border Background="#1e293b" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Margin="14,0,0,0" Padding="8,2">
                        <TextBlock Text="26 dnsspeedtest.online Servers" FontSize="11" Foreground="#38bdf8" FontWeight="Medium"/>
                    </Border>
                    <Border Background="#14532d" BorderBrush="#16a34a" BorderThickness="1" CornerRadius="12" Margin="8,0,0,0" Padding="8,2">
                        <TextBlock Text="🛡️ EU NIS2 &amp; GDPR Compliant" FontSize="11" Foreground="#86efac" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Benchmark latency, jitter, and recursion across safe DNS providers. Set static DNS to eliminate router lag." 
                           Foreground="#8b949e" FontSize="13" Margin="34,4,0,0"/>
            </StackPanel>

            <!-- Adapter Selection & Hardware Maximize -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Active Adapter:" Foreground="#8b949e" FontSize="11" Margin="0,0,0,2"/>
                    <ComboBox x:Name="AdapterCombo" Width="290" Height="34" 
                              Style="{StaticResource DarkComboBox}"
                              SelectionChanged="AdapterCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🌐" FontSize="13" Foreground="#38bdf8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="#f0f6fc" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text=" • " Foreground="#64748b" FontSize="11" Margin="3,0"/>
                                            <TextBlock Text="{Binding Status}" Foreground="#10b981" FontSize="11" FontWeight="Medium"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="#8b949e" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <Button x:Name="MaximizeNicBtn" Content="⚡ Maximize Adapters" Style="{StaticResource SecondaryBtn}" 
                        Height="32" Margin="0,16,8,0" Click="MaximizeNicBtn_Click" 
                        ToolTip="Disables Green Ethernet and power-saving jitter throttling on physical NICs"/>
                <Button x:Name="ConsoleGuideBtnTop" Content="🎮 PS5 / Xbox" Style="{StaticResource SecondaryBtn}" 
                        Height="32" Margin="0,16,0,0" Click="ConsoleGuideBtn_Click" 
                        ToolTip="Setup instructions for PlayStation 5, PS4, Xbox Series X|S &amp; Xbox One"/>
            </StackPanel>
        </Grid>

        <!-- Champion / Winner Card -->
        <Border Grid.Row="1" x:Name="ChampionCard" 
                Background="#161b22" BorderBrush="#f59e0b" BorderThickness="1.5" CornerRadius="10" 
                Padding="20,16" Margin="0,0,0,16" Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#292524" CornerRadius="8" Width="48" Height="48" Margin="0,0,18,0">
                    <TextBlock Text="🏆" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="OPTIMAL STATIC RESOLVER:" Foreground="#f59e0b" FontWeight="Bold" FontSize="11"/>
                        <TextBlock x:Name="WinnerNameText" Text="Cloudflare (1.1.1.1)" Foreground="#ffffff" FontWeight="Bold" FontSize="15" Margin="8,0,0,0"/>
                        <TextBlock x:Name="WinnerCountryText" Text="🇺🇸 United States" Foreground="#8b949e" FontSize="13" Margin="8,0,0,0"/>
                        <Border x:Name="WinnerEuBadge" Background="#14532d" BorderBrush="#16a34a" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0">
                            <TextBlock Text="🇪🇺 NIS2/GDPR Compliant" FontSize="10" Foreground="#86efac" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Primary Static IP: " Foreground="#8b949e" FontSize="12"/>
                        <TextBlock x:Name="WinnerPrimaryText" Text="1.1.1.1" Foreground="#38bdf8" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0"/>
                        <TextBlock Text="Secondary Static IP: " Foreground="#8b949e" FontSize="12"/>
                        <TextBlock x:Name="WinnerSecondaryText" Text="1.0.0.1" Foreground="#38bdf8" FontWeight="SemiBold" FontSize="12" Margin="0,0,24,0"/>
                        <TextBlock Text="Median Ping: " Foreground="#8b949e" FontSize="12"/>
                        <TextBlock x:Name="WinnerPingText" Text="4.0 ms" Foreground="#10b981" FontWeight="Bold" FontSize="12" Margin="0,0,16,0"/>
                        <TextBlock Text="Jitter: " Foreground="#8b949e" FontSize="12"/>
                        <TextBlock x:Name="WinnerJitterText" Text="0.0 ms" Foreground="#10b981" FontWeight="Bold" FontSize="12" Margin="0,0,16,0"/>
                        <TextBlock Text="Availability: " Foreground="#8b949e" FontSize="12"/>
                        <TextBlock x:Name="WinnerAvailText" Text="100%" Foreground="#10b981" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ConsoleGuideBtn" Content="🎮 Console Setup" Style="{StaticResource SecondaryBtn}" 
                            Height="38" Margin="0,0,8,0" Click="ConsoleGuideBtn_Click"
                            ToolTip="Setup this winning DNS on PlayStation 5, PS4, Xbox Series X|S &amp; Xbox One"/>
                    <Button x:Name="ApplyWinnerBtn" Content="🔒 Lock As Static DNS On All Adapters" Style="{StaticResource PrimaryBtn}" 
                            Height="38" Margin="0,0,8,0" Click="ApplyWinnerBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Benchmark Controls, EU Filter & Progress -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RunBenchmarkBtn" Content="▶ Run Benchmark (26 Servers)" Style="{StaticResource PrimaryBtn}" 
                        Click="RunBenchmarkBtn_Click" Margin="0,0,14,0"/>
                
                <CheckBox x:Name="EuFilterCheck" Content="🇪🇺 EU Cybersecurity Only (NIS2/GDPR)" 
                          Foreground="#cbd5e1" FontWeight="Medium" FontSize="12" VerticalAlignment="Center"
                          Checked="EuFilterCheck_Changed" Unchecked="EuFilterCheck_Changed"
                          ToolTip="Filter exclusively to European sovereign &amp; NIS2/GDPR audited privacy resolvers (e.g. DNS4EU, Quad9, DNS.SB)"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                <TextBlock x:Name="StatusText" Text="Ready. Click 'Run Benchmark' to test all 26 servers live." 
                           Foreground="#8b949e" FontSize="12" Margin="0,0,0,4"/>
                <ProgressBar x:Name="BenchmarkProgress" Height="6" Background="#21262d" Foreground="#10b981" 
                             BorderThickness="0" Value="0" Maximum="26"/>
            </StackPanel>

            <TextBox x:Name="SearchBox" Grid.Column="2" Width="180" Height="32" 
                     Background="#161b22" Foreground="#f0f6fc" BorderBrush="#30363d" 
                     Padding="8,5" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged" ToolTip="Filter by name or country"/>
        </Grid>

        <!-- Servers DataGrid -->
        <Border Grid.Row="3" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <DataGrid x:Name="ServersGrid" AutoGenerateColumns="False" 
                      Background="Transparent" BorderThickness="0"
                      RowBackground="#161b22" AlternatingRowBackground="#1c2128"
                      Foreground="#f0f6fc" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262d"
                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" SelectionMode="Single" RowHeight="42">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0d1117"/>
                        <Setter Property="Foreground" Value="#8b949e"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#30363d"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Rank -->
                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="45">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#f59e0b"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="14,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Name + Flag -->
                    <DataGridTemplateColumn Header="DNS Server" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Flag}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- IPs -->
                    <DataGridTemplateColumn Header="Static IP Addresses" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding PrimaryIp}" Foreground="#38bdf8" FontFamily="Consolas, monospace" FontSize="12"/>
                                    <TextBlock Text="{Binding SecondaryIp}" Foreground="#64748b" FontFamily="Consolas, monospace" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Ping Latency -->
                    <DataGridTextColumn Header="Ping (ms)" Binding="{Binding PingDisplay}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#10b981"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- DNS Query Latency -->
                    <DataGridTextColumn Header="Lookup (ms)" Binding="{Binding DnsQueryDisplay}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#93c5fd"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Jitter -->
                    <DataGridTextColumn Header="Jitter" Binding="{Binding JitterDisplay}" Width="85">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#a7f3d0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Availability -->
                    <DataGridTextColumn Header="Uptime" Binding="{Binding AvailabilityDisplay}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#f1f5f9"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- EU Compliance Badge -->
                    <DataGridTemplateColumn Header="EU Protocols" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#14532d" BorderBrush="#16a34a" BorderThickness="1" 
                                        CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Visibility="{Binding IsEuCompliant, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="🇪🇺 NIS2/GDPR" FontSize="10" Foreground="#86efac" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Feature Tag -->
                    <DataGridTemplateColumn Header="Tag" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#1e293b" BorderBrush="#334155" BorderThickness="1" 
                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="#cbd5e1"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Action Column -->
                    <DataGridTemplateColumn Header="Set Static" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Set Static" Style="{StaticResource ActionCellBtn}" 
                                        Click="RowUseDnsBtn_Click" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Notification / Summary Bar -->
        <Border Grid.Row="4" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6" 
                Margin="0,12,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="NotificationText" Text="Static DNS mode active. Automatic DHCP is disabled." 
                           Foreground="#8b949e" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="NIS2 &amp; GDPR Compliant • Zero Telemetry" 
                           Foreground="#10b981" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
